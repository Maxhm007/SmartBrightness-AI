<Application x:Class="SmartBrightness.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10141D" />
        <SolidColorBrush x:Key="CardBackground" Color="#1A2230" />
        <SolidColorBrush x:Key="Accent" Color="#75D6C2" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F5F9" /></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#10141D" /><Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="16,9" /><Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
